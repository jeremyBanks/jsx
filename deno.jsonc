{
  "name": "@jeb/jsx",
  "version": "0.0.20250222",
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@jeb/jsx",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "jsx-no-children-prop",
        "jsx-no-unescaped-entities",
        "require-await"
      ]
    }
  },
  "imports": {
    "@jeb/jsx": "./src/mod.ts",
    "@jeb/jsx/jsx-runtime": "./src/impl-jsx.ts",
    "@jeb/jsx/jsx-dev-runtime": "./src/impl-jsx.ts"
  },
  "exports": {
    ".": "./src/jsx-mod.tsx",
    "./jsx-runtime": "./src/impl-jsx.ts",
    "./jsx-dev-runtime": "./src/impl-jsx.ts"
  },
  "tasks": {
    "example": "deno run --allow-net example/serve.tsx",
    "test": "deno test",
    "deployctl": "deno run -A jsr:@deno/deployctl"
  },
  "deploy": {
    "project": "cb8fd3c5-b073-45c4-b078-83ff24d07635",
    "include": [
      "./src",
      "./example",
      "./deno.*"
    ],
    "entrypoint": "example/serve.tsx"
  }
}
